        <name>Base Registration capacity validation</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
  if (isLoading || newValue === '') return;

  var ga = new GlideAjax('x_1834930_office_0.BaseRegistrationValidation');
  ga.addParam('sysparm_name', 'checkBaseCapacity');
  ga.addParam('sysparm_base_id', newValue);

  ga.getXMLAnswer(function(response) {
    if (response === 'FULL') {
      var msg = 'The maximum capacity for this base has been reached.';
      g_form.setValue('base', '');
      g_form.showFieldMsg('base', msg, 'error');
      g_form.addErrorMessage(msg);
      spModal.alert(msg);
    }
  });
}]]></script>
