        <script><![CDATA[function onLoad() {
  g_form.setValue('is_user_already_registered', '');

  var userId = g_form.getValue('user');
  if (!userId) return;

  var ga = new GlideAjax('x_1834930_office_0.BaseRegistrationValidation');
  ga.addParam('sysparm_name', 'checkUserAlreadyRegistered');
  ga.addParam('sysparm_user_id', userId);

  ga.getXMLAnswer(function(ans) {
    var isDup = (ans === 'ALREADY_REGISTERED');
    g_form.setValue('is_user_already_registered', isDup ? 'true' : 'false');
  });
}]]></script>
